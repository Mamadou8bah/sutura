{
  "expo": {
    "name": "Sutura Agent",
    "slug": "sutura-agent",
    "scheme": "suturaagent",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "gm.sutura.agent",
      "supportsTablet": false,
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "package": "gm.sutura.agent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "icon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sutura Agent to scan customer QR codes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sutura to use Face ID to unlock your saved session on this device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "92599363-6b26-41a2-91ce-0cb40d99a399"
      }
    },
    "owner": "mamadou8bah",
    "icon": "./assets/app-icon.png"
  }
}
