{
  "expo": {
    "name": "Sutura App",
    "slug": "sutura-app",
    "scheme": "suturaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "gm.sutura.customer",
      "supportsTablet": false
    },
    "android": {
      "package": "gm.sutura.customer",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sutura to scan merchant payment QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4fc56f4-d8d4-4f9f-b353-a37b1482d8a7"
      }
    },
    "owner": "mamadou8bah",
    "icon": "./assets/sutura-logo.png"
  }
}
