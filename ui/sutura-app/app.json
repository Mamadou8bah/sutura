{
  "expo": {
    "name": "Sutura App",
    "slug": "sutura-app",
    "scheme": "suturaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "gm.sutura.customer",
      "supportsTablet": false,
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "package": "gm.sutura.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "icon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sutura to scan merchant payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sutura to use Face ID to unlock your saved session on this device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4fc56f4-d8d4-4f9f-b353-a37b1482d8a7"
      }
    },
    "owner": "mamadou8bah",
    "icon": "./assets/app-icon.png"
  }
}
