{
  "expo": {
    "name": "Sutura Merchant",
    "slug": "sutura-merchant",
    "scheme": "suturamerchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "gm.sutura.merchant",
      "supportsTablet": false
    },
    "android": {
      "package": "gm.sutura.merchant",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
