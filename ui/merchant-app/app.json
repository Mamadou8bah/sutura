{
  "expo": {
    "name": "Sutura Merchant",
    "slug": "sutura-merchant",
    "scheme": "suturamerchant",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "gm.sutura.merchant",
      "supportsTablet": false,
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "gm.sutura.merchant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181a20",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "icon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Sutura to use Face ID to unlock your saved session on this device."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a29016c3-50c4-4f5c-ab25-dfbcd33a74c8"
      }
    },
    "owner": "mamadou8bah",
    "icon": "./assets/app-icon.png"
  }
}
