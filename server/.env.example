# Copy to server/.env (gitignored) for Compose. Java/Maven need exported variables.
# Render uses service Environment settings. Never commit credentials.
# Database: use the PostgreSQL JDBC URL, username and password from your host.
# URL format: jdbc:postgresql://HOST:5432/DATABASE
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
# Render Key Value internal connection URL: redis://HOST:6379
REDIS_URL=
# Public API DNS must point to the server; Caddy obtains an HTTPS certificate.
SUTURA_API_DOMAIN=api.example.com
SUTURA_CORS_ALLOWED_ORIGINS=https://app.example.com
# Required only when enabling the optional web service profile.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
POSTGRES_DB=sutura
POSTGRES_USER=sutura
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# Sentinel is deployed separately. Private-network HTTP or HTTPS is supported.
SUTURA_SENTINEL_BASE_URL=
SUTURA_SENTINEL_API_KEY=
SUTURA_SENTINEL_TENANT_CODE=
# Independent random signing secrets, each at least 32 characters.
SUTURA_SENTINEL_WEBHOOK_SECRET=
MODEMPAY_WEBHOOK_SIGNING_SECRET=
MODEMPAY_API_KEY=
# Leave disabled until the provider credentials and webhook are configured.
MODEMPAY_ENABLED=false
MODEMPAY_PUBLIC_KEY=
MODEMPAY_API_URL=https://api.modempay.com
# Production requires working SMS and email delivery; noop is refused.
SUTURA_SMS_PROVIDER=jokoor
# SMS requires a live Jokoor API key (sk_live_*).
JOKOOR_API_KEY=
# Resend HTTPS email delivery. Use a sender on a domain verified in Resend.
SUTURA_EMAIL_PROVIDER=resend
SUTURA_EMAIL_API_KEY=
SUTURA_EMAIL_FROM=
# Optional alternative, used only with SUTURA_EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Operations alerts for uncertain payouts, critical risk and reconciliation failures.
SUTURA_ALERT_EMAIL=

# Render / first-deployment settings. The preparation script selects Render defaults.
# Keep bootstrap disabled for ordinary local use; enable once for initial deployment.
SPRING_PROFILES_ACTIVE=
SUTURA_BOOTSTRAP_ENABLED=false
SUTURA_BOOTSTRAP_FIRST_NAME=Admin
SUTURA_BOOTSTRAP_LAST_NAME=Sutura
SUTURA_BOOTSTRAP_EMAIL=
SUTURA_BOOTSTRAP_PHONE=
SUTURA_BOOTSTRAP_PASSWORD=
