# Local configuration and generated outputs
.env
.env.*
!.env.example
*.log
*.tsbuildinfo
node_modules/
__pycache__/
*.py[cod]
**/.expo-web-test*/
.idea/
.vscode/
*.iml

# Expo web export artifacts are built by hosting, never committed.
ui/*/dist/

# Expo native projects are generated from app config; keep builds and signing keys local.
ui/*/android/
ui/*/ios/
ui/*/.ota-validation/

# Downloaded EAS signing material stays on the build machine.
ui/*/credentials.json
ui/*/credentials/
ui/*/*.jks
ui/*/*.keystore
# Firebase admin credentials are server secrets; google-services.json is client configuration.
**/*firebase-adminsdk*.json
**/*service-account*.json
